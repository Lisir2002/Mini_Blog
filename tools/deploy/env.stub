#!/usr/bin/env bash
# 远程运行时安装（幂等）：nginx / php-fpm / MariaDB + PDO 扩展，建库建用户。
# 占位符由 deploy.php 注入：{{ROOT}} {{DB}} {{DBUSER}} {{DBPASS}}
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
echo "[env] 目标主机 $(hostname)，系统 $( . /etc/os-release && echo "$PRETTY_NAME" )"

# 1) 软件源刷新 + 安装（已装的包 apt 会跳过，天然幂等）
apt-get update -qq
apt-get install -y -qq nginx mariadb-server php-fpm php-mysql php-mbstring php-xml php-curl unzip curl >/dev/null
PHP_VER="$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')"
echo "[env] PHP ${PHP_VER} / nginx $(nginx -v 2>&1 | sed 's#.*/##') 已就绪"

# 2) 启动并设为开机自启
service mariadb start >/dev/null 2>&1 || systemctl start mariadb >/dev/null 2>&1 || true
systemctl enable mariadb >/dev/null 2>&1 || true
systemctl enable nginx >/dev/null 2>&1 || true
FPM="php${PHP_VER}-fpm"
systemctl enable "$FPM" >/dev/null 2>&1 || true
service "$FPM" start >/dev/null 2>&1 || systemctl restart "$FPM" >/dev/null 2>&1 || true

# 3) 建库建用户（重复执行安全：CREATE IF NOT EXISTS + 按需重设口令）
mysql <<SQL
CREATE DATABASE IF NOT EXISTS \`{{DB}}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS '{{DBUSER}}'@'127.0.0.1' IDENTIFIED BY '{{DBPASS}}';
CREATE USER IF NOT EXISTS '{{DBUSER}}'@'localhost' IDENTIFIED BY '{{DBPASS}}';
ALTER USER '{{DBUSER}}'@'127.0.0.1' IDENTIFIED BY '{{DBPASS}}';
ALTER USER '{{DBUSER}}'@'localhost' IDENTIFIED BY '{{DBPASS}}';
GRANT ALL PRIVILEGES ON \`{{DB}}\`.* TO '{{DBUSER}}'@'127.0.0.1';
GRANT ALL PRIVILEGES ON \`{{DB}}\`.* TO '{{DBUSER}}'@'localhost';
FLUSH PRIVILEGES;
SQL
echo "[env] 数据库 {{DB}} / 用户 {{DBUSER}} 已就绪"

# 4) 部署根与运行时目录
mkdir -p '{{ROOT}}/storage' '{{ROOT}}/config'
chown -R www-data:www-data '{{ROOT}}' 2>/dev/null || true
echo "[env] 环境安装完成"
