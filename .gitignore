# 调试与验证脚本：写在 /tmp，不属于项目
*.py
*.sh
*.bash
*.ps1
*.bat
*.cmd

# 编辑器与合并残留
*.bak
*.orig
*.rej
*.tmp
*.swp
*.swo
*~

# 日志与本地数据库转储
*.log
*.sqlite
*.sqlite3
*.db
dump.sql
*.dump

# 运行时目录：只提交骨架（.gitkeep），内容由站点自行生成
storage/**
!storage/**/
!storage/**/.gitkeep

# 安装器与本地覆盖层：每台机器各自生成，不入库
storage/install.token
storage/install.lock
config/local.php

# 审计报告含 generated_at，每次跑测试都会变；由 tools/audit-responsibility.php 本地生成
docs/responsibility-report.json
